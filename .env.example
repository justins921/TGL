# Neon Database
# Get your connection string from: https://console.neon.tech → Your Project → Connection Details
# Use the "Connection string" (starts with postgres://)
VITE_DATABASE_URL=postgres://user:password@your-project.neon.tech/neondb?sslmode=require

# Admin Password
# Set this to any password you want for admin access
VITE_ADMIN_PASSWORD=your-admin-password
